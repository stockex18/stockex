NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=StockEx

NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ── StockEx Buddy (home-page help chat, no AI) ──────────────────────────
# Mobile OTP before chatting: signs the "verified" cookie. SERVER-ONLY, any
# random string of 32+ characters (e.g. `openssl rand -hex 32`). If unset,
# nobody can verify and the chat stays behind the OTP step.
MARKETING_BOT_SESSION_SECRET=
# Optional: where this server reaches FastAPI for the OTP calls (e.g.
# http://127.0.0.1:8000 on the server). Defaults to NEXT_PUBLIC_API_URL.
MARKETING_BOT_BACKEND_URL=
# Public "Follow StockEx" links in the chat (hidden when blank). Baked in at
# build time — rebuild after changing.
NEXT_PUBLIC_STOCKEX_FACEBOOK_URL=
NEXT_PUBLIC_STOCKEX_INSTAGRAM_URL=
